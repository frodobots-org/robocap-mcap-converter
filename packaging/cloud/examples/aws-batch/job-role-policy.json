{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListInputPrefix",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::CUSTOMER_RAW_BUCKET",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["session/*"]
        }
      }
    },
    {
      "Sid": "ReadInputObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": "arn:aws:s3:::CUSTOMER_RAW_BUCKET/session/*"
    },
    {
      "Sid": "WriteOutputObjects",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:AbortMultipartUpload"],
      "Resource": "arn:aws:s3:::CUSTOMER_OUTPUT_BUCKET/mcap/*"
    }
  ]
}
